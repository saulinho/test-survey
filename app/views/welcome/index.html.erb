<h1><%= @survey.description %></h1>

<% @survey.questions.each do |question| %>
  <h2><%= question.description %></h2>
  <%= line_chart ReplyOption.joins(:option).where(reply_options: { checked: true }, "options.question_id": question.id).group("options.description").count, code:true,  download: true %>
<% end %>
